{
  "name": "sunset",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "check-types": "turbo run check-types",
    "format:check": "prettier --check . --ignore-unknown",
    "check": "pnpm format:check && pnpm check-types && pnpm test && pnpm build",
    "format": "prettier --write . --ignore-unknown"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.13.0"
  }
}
